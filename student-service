pipeline {
    agent {
        label 'microservice'
    }

    stages {

        stage('git-checkout') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/devixhub/student-service.git'
            }
        }

        stage('maven-package') {
            steps {
                sh 'mvn clean package'
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('SonarServer') {
                    sh '''
                        mvn org.sonarsource.scanner.maven:sonar-maven-plugin:sonar \
                        -Dsonar.projectKey=student-service
                    '''
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 3, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Checkout Dockerfile') {
            steps {
                dir('docker-repo') {
                    git branch: 'main',
                        url: 'https://github.com/devixhub/cicd.git'
                }
            }
        }

        stage('Docker build') {
            steps {
                sh 'echo "Docker build started..."'

                sh 'docker build -f docker-repo/student-service-Dockerfile -t student-service:${BUILD_NUMBER} .'
            }
        }
    }
}
