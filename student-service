pipeline {
    agent {
        label 'microservice'
    }

    stages {
        stage('git-cheakout') {
            steps {
                git branch: 'main', url: 'https://github.com/devixhub/student-service.git'
            }
        }
         stage('maven-package') {
            steps {
                sh 'mvn clean package'
            }
        }
    }
}
